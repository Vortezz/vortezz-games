{
	"name": "api",
	"version": "0.0.0",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsup",
		"build:watch": "tsup --onSuccess \"echo 'tsup build finished.'\"",
		"start:dev": "nodemon dist dist/index.js",
		"dev": "npm-run-all --parallel build:watch start:dev",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@repo/typescript-config": "*",
		"nodemon": "^3.1.11",
		"npm-run-all": "^4.1.5",
		"tsup": "^8.0.1",
		"typescript": "5.5.4"
	},
	"dependencies": {
		"@repo/shared": "*",
		"@types/ws": "^8.18.1",
		"ws": "^8.18.3"
	}
}
